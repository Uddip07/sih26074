# ---- Data: everything below is regenerated by `python -m src.pipeline.run` ----
# raw downloads (DEM tiles, WorldCover, CHIRPS cubes, API caches, shared global files)
data/*/raw/**
!data/*/raw/boundaries/
!data/*/raw/boundaries/*.geojson
data/_shared/
# large regenerable tables (> 20 MB); small interim tables are committed for review
data/*/processed/
data/*/interim/gp_nwp_grid_reference.parquet
data/*/interim/gp_met_obs.parquet
# model binaries and per-issue runtime outputs (models are rebuilt by the train stage)
outputs/*/models/*.joblib
outputs/*/models/*test_predictions_*.parquet
outputs/*/forecasts/
outputs/*/bulletins/
outputs/*/logs/
outputs/*/app.db
outputs/*/web/verification_gp_lead1.parquet
*.tif
*.tiff
*.nc4
*.nc
*.grd
*.part
.env

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Node (none used; guard against accidental installs)
node_modules/

