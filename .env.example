# Copy to .env (never commit .env). All variables are optional.
# Officer write endpoints (review/publish/run/upload). If unset, they are localhost-only.
AGROMET_ADMIN_TOKEN=change-me
# Comma-separated browser origins allowed to call the API (CORS off when empty)
AGROMET_CORS_ORIGINS=
# Salt for hashing demo subscriber phone numbers
AGROMET_PHONE_SALT=change-me-too
# Alternative district config
AGROMET_CONFIG=config/district_pune.yaml
# Optional second rainfall truth (GPM IMERG) - NASA Earthdata login
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
